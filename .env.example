# ─────────────────────────────────────────────────────────────────────────────
# Offline PO Agent — environment. Copy to .env.local and fill in what you need.
# The whole feature is OFF until PO_AGENT_ENABLED=true.
# ─────────────────────────────────────────────────────────────────────────────

# ── BigCommerce store context (the single store token; B2B uses the SAME token) ──
BIGCOMMERCE_STORE_HASH=
BIGCOMMERCE_ACCESS_TOKEN=          # store API account token with B2B Edition = modify
BIGCOMMERCE_CHANNEL_ID=1          # store-specific; "1" is only the default channel

# ── PO agent core ────────────────────────────────────────────────────────────
PO_AGENT_ENABLED=                 # "true" to enable; empty = fully inert (default)
PO_AGENT_MODE=auto                # auto | review (review = queue instead of auto-submit)
PO_AGENT_CHANNEL=google           # google | microsoft

# ── BYO AI provider (Vercel AI SDK provider registry) ────────────────────────
PO_AGENT_MODEL=                   # "provider:model-id", e.g. anthropic:claude-sonnet-4-6
PO_AGENT_FALLBACK_MODEL=          # optional retry model on provider error
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# Azure: AZURE_RESOURCE_NAME / AZURE_API_KEY

# ── State (Upstash Redis, REST) ──────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# (KV_REST_API_URL / KV_REST_API_TOKEN aliases also accepted)

# ── Gmail channel (POC mailbox) ──────────────────────────────────────────────
GOOGLE_PO_CLIENT_ID=              # dedicated OAuth "Internal" web client
GOOGLE_PO_CLIENT_SECRET=
GOOGLE_PO_REFRESH_TOKEN=          # one-time consent by the mailbox user
GOOGLE_PO_PUBSUB_TOPIC=          # projects/<proj>/topics/<topic>
PO_AGENT_INBOUND_SECRET=         # shared secret for push routes (or OIDC audience)

# ── Microsoft channel (Phase 7, optional) ────────────────────────────────────
MS_PO_TENANT_ID=
MS_PO_CLIENT_ID=
MS_PO_CLIENT_SECRET=
MS_PO_MAILBOX=                   # UPN of the monitored mailbox

# ── Multi-storefront (MSF) — optional; single-storefront stores leave empty ──
PO_AGENT_CHANNEL_MAP=            # JSON mailbox→channelId, e.g. {"poc@silkcommerce.com":1}

# ── Workflow tuning ──────────────────────────────────────────────────────────
PO_AGENT_MAX_CLARIFICATIONS=2
PO_AGENT_MAX_REPLIES_PER_THREAD=6
PO_AGENT_PRICE_TOLERANCE_PCT=1
PO_AGENT_ESCALATE_VALUE=25000    # totals above this + low confidence ⇒ escalate
PO_AGENT_PO_PAYMENT_CODES=       # store's pay-on-account paymentCode(s), comma-sep
PO_AGENT_QUOTE_EMAIL=own         # own | native (also send B2B rfq/emails template)

# ── Lifecycle, trust & cost guardrails ───────────────────────────────────────
PO_AGENT_REMINDER_DAYS=3
PO_AGENT_SESSION_EXPIRY_DAYS=10
PO_AGENT_FIRST_ORDER_CONFIRM=true
PO_AGENT_SESSION_TOKEN_BUDGET=   # soft per-session model-token cap (empty = off)
PO_AGENT_DAILY_SUBMIT_CAP=       # max auto-submissions/day (empty = off)
PO_AGENT_SIMULATOR_SEND=false    # simulator never emails unless explicitly true
PO_AGENT_ALLOW_DOMAIN_FALLBACK=false

# ── Escalation fan-out (each empty = channel disabled; queue is always on) ────
PO_AGENT_ESCALATION_EMAIL=
PO_AGENT_SLACK_WEBHOOK_URL=

# ── Optional: official BigCommerce Storefront MCP (Beta) tool mount ──────────
BIGCOMMERCE_STOREFRONT_MCP_URL=
